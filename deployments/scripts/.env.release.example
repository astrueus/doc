# Gitea 本地发版用环境变量（复制为 .env.release 后填写，勿提交）
# 复制命令：
#   Windows: copy deployments\scripts\.env.release.example deployments\scripts\.env.release
#   Linux:   cp deployments/scripts/.env.release.example deployments/scripts/.env.release
#
# 用法：
#   Windows: deployments\scripts\release.bat 0.0.1-test windows --dry-run
#   Linux:   ./deployments/scripts/release.sh 0.0.1-test linux --dry-run
#            ./deployments/scripts/release.sh 0.0.1-test linux --env=deployments/scripts/.env.release --draft
#   或：     make release VERSION=0.0.1-test
#            just release 0.0.1-test

GITEA_URL=https://git.itopcms.com
GITEA_TOKEN=
GITEA_OWNER=
GITEA_REPO=doc

# GitHub Releases（仅在命令行加 --github / --github-only 时使用；默认只发 Gitea）
# PAT 需要能写 Release（私有仓：Contents + Releases，或 classic 的 repo）
# owner/repo 可省略，默认与上面 Gitea 相同
GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=doc
