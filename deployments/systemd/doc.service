[Unit]
Description=doc
After=syslog.target
After=network.target
After=mysqld.service

[Service]
# Modify these two values and uncomment them if you have
# repos with lots of files and get an HTTP error 500 because
# of that
###
#LimitMEMLOCK=infinity
#LimitNOFILE=65535
Type=simple
User=root
Group=root
# WorkingDirectory 须含 configs/、web/、runtime/（Round 2 布局）
WorkingDirectory=/data/wwwroot/doc.itopcms.com
# 无子命令时默认启动 web；也可写成 .../doc web
ExecStart=/data/wwwroot/doc.itopcms.com/doc
Restart=always
# Environment=DOC_HOME=/data/wwwroot/doc.itopcms.com
#Environment=USER=www HOME=/home/www

# Some distributions may not support these hardening directives. If you cannot start the service due
# to an unknown option, comment out the ones not supported by your version of systemd.
#ProtectSystem=full
PrivateDevices=yes
PrivateTmp=yes
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
