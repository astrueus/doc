# Gitea 本地发版用环境变量（复制为 .env.release 后填写，勿提交）
# 复制命令：
#   Windows: copy scripts\.env.release.example scripts\.env.release
#   Linux:   cp scripts/.env.release.example scripts/.env.release
#
# 用法：
#   Windows: scripts\release.bat 0.0.1-test windows --dry-run
#   Linux:   ./scripts/release.sh 0.0.1-test linux --dry-run
#            ./scripts/release.sh 0.0.1-test linux --env=scripts/.env.release --draft

GITEA_URL=https://git.itopcms.com
GITEA_TOKEN=
GITEA_OWNER=jackliu
GITEA_REPO=doc
